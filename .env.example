# Public site config (inlined into the client bundle at `next build`)
NEXT_PUBLIC_SITE_URL=https://www.medicareinspokane.com
NEXT_PUBLIC_SITE_ENV=development
# Optional: leave unset to disable Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Server-side Firebase / Firestore (used by the lead form API route)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public Firebase Auth config used only by the feature-gated editorial sign-in.
# These identify the Firebase web app and are not service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-side editorial CMS. Keep false until Firebase Auth, authorized domains,
# and explicit knowledgeCmsRoles custom claims are configured.
KNOWLEDGE_CMS_ENABLED=false

# Server-only renderer contract. Exact shadow enables only the private
# comparison workspace; public routes stay static in every accepted mode.
KNOWLEDGE_CMS_PUBLIC_RENDERER_MODE=static

# Separate server-only gate for one-at-a-time Resource Library article draft
# creation. This is inert unless KNOWLEDGE_CMS_ENABLED is also exact true.
KNOWLEDGE_CMS_ARTICLE_MIGRATION_EXECUTION_ENABLED=false

# Server-side CRM Developer API (never expose these to the browser)
CRM_API_BASE_URL=https://crm-staging-846810195003.us-west1.run.app
CRM_API_KEY=
